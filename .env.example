APP_NAME=PolicyFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database Configuration ---
# Default zero-setup local option (SQLite):
DB_CONNECTION=sqlite
# For SQLite, the database file is automatically located at database/database.sqlite

# Alternatively, for MySQL 8+:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=policyflow
# DB_USERNAME=root
# DB_PASSWORD=secret

# Alternatively, for PostgreSQL:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=policyflow
# DB_USERNAME=postgres
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- PolicyFlow Configuration ---
# Default scenario for mock insurer when not explicitly overridden via header or body:
# Options: SUCCESS, TEMPORARY_FAILURE, TIMEOUT_AFTER_ISSUE, DELAYED_CALLBACK, DUPLICATE_CALLBACK
MOCK_INSURER_SCENARIO=SUCCESS
